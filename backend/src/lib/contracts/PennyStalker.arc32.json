    "state": {
        "global": {
            "num_byte_slices": 0,
            "num_uints": 1
        },
        "local": {
            "num_byte_slices": 0,
            "num_uints": 1
        }
    },
    "schema": {
        "global": {
            "declared": {
                "usdcAsset": {
                    "type": "uint64",
                    "key": "usdc"
                }
            },
            "reserved": {}
        },
        "local": {
            "declared": {
                "nextGoalId": {
                    "type": "uint64",
                    "key": "next_id"
                }
            },
            "reserved": {}
        }
    },
    "contract": {
        "name": "PennyStalker",
        "methods": [
            {
                "name": "createApplication",
                "args": [
                    {
                        "type": "uint64",
                        "name": "usdcAsset"
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Called once by the deployer to initialize the contract with the USDC asset."
            },
            {
                "name": "optIntoUsdc",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Called by the platform deployer to opt the contract into USDC so it can receive tokens."
            },
            {
                "name": "optInToApp",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Called by a user to opt into the application and initialize their local state."
            },
            {
                "name": "createGoal",
                "args": [
                    {
                        "type": "string",
                        "name": "name",
                        "desc": "- A human-readable label for the goal (e.g., \"New Car\")."
                    },
                    {
                        "type": "uint64",
                        "name": "targetAmount",
                        "desc": "- The USDC target in the asset's smallest unit (e.g. micro-USDC)."
                    },
                    {
                        "type": "uint64",
                        "name": "deadline",
                        "desc": "- A Unix timestamp after which the goal can be force-withdrawn."
                    },
                    {
                        "type": "pay",
                        "name": "mbrPay",
                        "desc": "- A payment transaction covering the Algorand Box MBR. This ALGO\n  is airdropped to the user's wallet by the platform on sign-up."
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "uint64",
                    "desc": "The new goal's ID (used as a reference for future deposits / withdrawals)."
                },
                "desc": "Creates a new savings goal backed by box storage."
            },
            {
                "name": "deposit",
                "args": [
                    {
                        "type": "uint64",
                        "name": "goalId",
                        "desc": "- The ID of the goal to deposit into."
                    },
                    {
                        "type": "axfer",
                        "name": "axfer",
                        "desc": "- The asset transfer transaction sending USDC to this contract."
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Deposits USDC into a specific savings goal."
            },
            {
                "name": "withdraw",
                "args": [
                    {
                        "type": "uint64",
                        "name": "goalId",
                        "desc": "- The ID of the goal to withdraw from."
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Withdraws all USDC from a savings goal once it is completed or past its deadline.\nAlso refunds the box MBR back to the caller and deletes the box."
            }
        ],
        "networks": {}
    },
    "bare_call_config": {}
}